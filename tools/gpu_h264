#!/usr/bin/env python3
"""Publish low-latency Annex B H.264 from D435 color using desktop NVENC."""
from fractions import Fraction
import av
import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data, QoSProfile, ReliabilityPolicy
from sensor_msgs.msg import CompressedImage, Image


class Encoder(Node):
    def __init__(self):
        super().__init__('waffle_nvenc')
        self.codec=None
        self.pub=self.create_publisher(CompressedImage,'waffle/h264',5)
        input_qos = self.declare_parameter('input_qos', 'SENSOR_DATA').value
        qos = (QoSProfile(depth=3, reliability=ReliabilityPolicy.RELIABLE)
               if input_qos == 'RELIABLE' else qos_profile_sensor_data)
        self.create_subscription(Image, 'camera/color/image_raw', self.encode, qos)
    def encode(self,msg):
        if msg.encoding not in ('rgb8','bgr8'):raise ValueError(msg.encoding)
        if self.codec is None or (self.codec.width,self.codec.height)!=(msg.width,msg.height):
            self.codec=av.CodecContext.create('h264_nvenc','w')
            self.codec.width=msg.width;self.codec.height=msg.height;self.codec.pix_fmt='yuv420p'
            self.codec.time_base=Fraction(1,30)
            self.codec.options={'preset':'p1','tune':'ull','zerolatency':'1','bf':'0','g':'30'}
            self.codec.open()
        pixels=np.frombuffer(msg.data,np.uint8).reshape(msg.height,msg.step)[:,:msg.width*3]
        frame=av.VideoFrame.from_ndarray(pixels.reshape(msg.height,msg.width,3),
                                        format='rgb24' if msg.encoding=='rgb8' else 'bgr24')
        for packet in self.codec.encode(frame):
            self.pub.publish(CompressedImage(header=msg.header,format='h264',data=bytes(packet)))

if __name__=='__main__':
    rclpy.init();node=Encoder()
    try:rclpy.spin(node)
    except KeyboardInterrupt:pass
    finally:node.destroy_node();rclpy.try_shutdown()
