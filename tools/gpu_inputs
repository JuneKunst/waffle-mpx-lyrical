#!/usr/bin/env python3
"""Feed NVIDIA example graph input names from an already-running Waffle D435."""
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import CameraInfo, Image


class Inputs(Node):
    def __init__(self):
        super().__init__('waffle_gpu_inputs')
        selected=self.declare_parameter('streams','rgb').value.split(',')
        routes={
            'rgb':[('camera/color/image_raw',Image,['image','image_raw']),
                   ('camera/color/camera_info',CameraInfo,['camera_info'])],
            'stereo':[(f'camera/infra{i}/image_rect_raw',Image,[side+'/image_rect']) for i,side in [(1,'left'),(2,'right')]]+
                     [(f'camera/infra{i}/camera_info',CameraInfo,[side+'/camera_info_rect',side+'/camera_info']) for i,side in [(1,'left'),(2,'right')]],
            'depth':[('camera/aligned_depth_to_color/image_raw',Image,['depth']),
                     ('camera/aligned_depth_to_color/camera_info',CameraInfo,['depth/camera_info'])],
        }
        for stream in selected:
            for src,msg,aliases in routes[stream]:
                pubs=[self.create_publisher(msg,name,2) for name in aliases]
                def forward(packet,pubs=pubs):
                    for pub in pubs:
                        if pub.get_subscription_count(): pub.publish(packet)
                self.create_subscription(msg,src,forward,qos_profile_sensor_data,raw=True)


if __name__=='__main__':
    rclpy.init()
    node=Inputs()
    try:rclpy.spin(node)
    except KeyboardInterrupt:pass
    finally:node.destroy_node();rclpy.try_shutdown()
